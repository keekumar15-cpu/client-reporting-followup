# Postgres connection (shared VPS Postgres, dedicated database + user)
DATABASE_URL=postgresql://reportsapp_user:<password>@postgresql-jld5-postgresql-1:5432/reportsdb

# Session
SESSION_SECRET=<random 32+ char string>
NODE_ENV=production

# Single admin login
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=<bcrypt hash — escape every $ as $$ when placed in docker-compose>

# Fixed owner id for this single-admin build (keep as-is unless you cut over
# to real multi-user auth later — see PRD Section 2.5 / C5)
OWNER_ID=00000000-0000-0000-0000-000000000001

# Display currency for the summary strip and add-client form
DEFAULT_CURRENCY=USD

PORT=4001
