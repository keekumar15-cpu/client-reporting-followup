# Place this file as .env next to docker-compose.yml on the VPS.
# Do NOT commit this file — it's already in .gitignore.

REPORTS_DB_PASSWORD=<the reportsapp_user password, set when the database was provisioned>
REPORTS_SESSION_SECRET=<random 32+ char string>
REPORTS_ADMIN_PASSWORD_HASH=<bcrypt hash of the admin password — plain value here, no escaping needed>
